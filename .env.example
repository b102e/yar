# Anthropic API key — get at platform.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram bot token — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: restrict to specific Telegram chat ID(s), comma-separated
TELEGRAM_ALLOWED_CHAT_ID=

# Agent data directory (default: ~/.agent)
# AGENT_DIR=~/.agent

# ── Тело (робот) ───────────────────────────────────────────────
# Секрет, которым робот представляется YAR. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто = тело выключено.
BODY_TOKEN=
# Слушать локально; наружу открывать через reverse proxy с TLS (см. ROBOT.md)
BODY_HOST=127.0.0.1
BODY_PORT=8765
# Модели (по умолчанию — как было)
# YAR_CHAT_MODEL=claude-sonnet-4-20250514
# YAR_AUTO_MODEL=claude-haiku-4-5-20251001
# Озвучивать ли автономные мысли через тело (0/1)
BODY_SPEAK_AUTONOMOUS=0
# Дублировать ли в Telegram ответы, которые уже прозвучали голосом из тела (0/1)
TELEGRAM_MIRROR_BODY=0
